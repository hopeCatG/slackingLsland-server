# Container runtime
APP_NAME=Slack-off API
APP_PORT=8000
WEB_CONCURRENCY=2
# Comma-separated web origins. Use your H5 domain; mini-program calls do not use CORS.
CORS_ALLOW_ORIGINS=https://your-web-domain.example

# Remote MySQL; do not use root in production.
MYSQL_HOST=192.144.226.149
MYSQL_PORT=3306
MYSQL_USER=replace-with-production-user
MYSQL_PASSWORD=replace-with-production-password
MYSQL_DATABASE=slack-off

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SECRET=replace-with-a-long-random-secret
